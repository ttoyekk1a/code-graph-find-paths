name: Frozen contract verification
on: [push, pull_request, workflow_dispatch]
permissions:
  contents: read
jobs:
  offline:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Verify all pinned files and 41 offline contracts
        working-directory: graph-find-paths
        run: python -I -B scripts/verify.py
      - name: Build installable package
        run: python -m pip wheel --no-deps . -w dist
      - name: Verify bundled frozen files
        run: python scripts/verify_wheel.py dist/code_graph_find_paths-0.2.1-py3-none-any.whl
      - name: Install standalone package with optional MCP transport
        run: python -m pip install '.[mcp]'
      - name: Standalone API and CLI checks (no competition SDK)
        run: python -m unittest discover -s tests -p 'test_standalone.py' -v
      - name: Standalone MCP integration
        run: python scripts/standalone_mcp_smoke.py
